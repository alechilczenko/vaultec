# App secrets (required)
SECRET_KEY=                          # openssl rand -hex 32  (min 32 chars)
ADMIN_SETUP_PASSWORD=                # 12+ chars; upper, lower, digit, symbol

# Postgres (used by compose for db + DATABASE_URL)
DB_USER=admin
DB_PASSWORD=password123
DB_NAME=app

# Optional overrides
# DATABASE_URL=postgresql://admin:password123@db:5432/app
# CHROME_PATH=/usr/bin/chromium
